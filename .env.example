# ==========================================================
# Slack App Configuration (Multi-Workspace OAuth & Bot)
# ==========================================================
# Get these from https://api.slack.com/apps -> Your App -> Basic Information & OAuth
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Single-workspace fallback bot token (optional if multi-workspace OAuth is used)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ==========================================================
# Application Base URL & OAuth Redirects
# ==========================================================
# Set this to your public domain or ngrok URL (e.g. https://your-subdomain.ngrok-free.dev)
APP_BASE_URL=http://localhost:8000
SLACK_REDIRECT_URI=http://localhost:8000/slack/oauth/callback

# ==========================================================
# Groq LLM Configuration
# ==========================================================
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# ==========================================================
# Database (PostgreSQL with pgvector for Multi-Tenant RAG)
# ==========================================================
DATABASE_URL=postgresql://username:password@your-rds-host.amazonaws.com:5432/postgres

# ==========================================================
# Google OAuth Integration (Calendar & Gmail)
# ==========================================================
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ==========================================================
# Proactive Notifications & Fallback Channel
# ==========================================================
DEFAULT_SLACK_CHANNEL=C0123456789
ENABLE_EVENT_NOTIFICATIONS=true
EVENT_POLL_INTERVAL_GMAIL=30
EVENT_POLL_INTERVAL_CALENDAR=60
MEETING_ALERT_WINDOW_MINUTES=30
