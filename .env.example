# ============================================================
# Slack Bot Configuration
# ============================================================
# Bot User OAuth Token from https://api.slack.com/apps (OAuth & Permissions)
# Required scopes: chat:write, app_mentions:read, channels:history, im:history
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ============================================================
# Groq AI Model Configuration
# ============================================================
# API Key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key
# Recommended models with strong tool-calling capabilities:
# - llama-3.3-70b-versatile
# - llama-3.1-70b-versatile
# - llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# Server Configuration
# ============================================================
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ============================================================
# Google Workspace (Calendar & Gmail) Credentials
# ============================================================
# Option A: File paths (standard OAuth flow with token.json)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Option B: Direct Environment Tokens (ideal for Docker / headless servers)
# GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# ============================================================
# Google Keep Configuration
# ============================================================
# For personal @gmail.com accounts using gkeepapi:
# Use your Google account email and an App Password (generated from https://myaccount.google.com/apppasswords)
# GOOGLE_KEEP_USERNAME=your_email@gmail.com
# GOOGLE_KEEP_PASSWORD=your_app_password
# Or pre-generated master token:
# GOOGLE_KEEP_MASTER_TOKEN=

# ============================================================
# Database Configuration (PostgreSQL with pgvector)
# ============================================================
# Option A: Full connection URL (used in ECS Fargate or with connection pooling)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slackbot
# AWS RDS Example:
# DATABASE_URL=postgresql://dbadmin:MyPassword123@my-rds-cluster.cxxxxxx.us-east-1.rds.amazonaws.com:5432/slackbot

# Option B: Individual connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=slackbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# SSL mode: "prefer" for local/docker-compose, "require" for AWS RDS PostgreSQL
DB_SSLMODE=prefer
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ============================================================
# RAG (Retrieval-Augmented Generation) & pgvector Settings
# ============================================================
ENABLE_RAG=true
# High performance ONNX embedding model:
# - BAAI/bge-small-en-v1.5 (dim: 384, default, ultra-fast)
# - sentence-transformers/all-MiniLM-L6-v2 (dim: 384)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RAG_TOP_K=5
# Cosine similarity threshold (0.0 - 1.0). Only chunks above this score are passed to LLM
RAG_SIMILARITY_THRESHOLD=0.60
# Number of recent conversation messages to keep in active memory
SHORT_TERM_MEMORY_LIMIT=6

